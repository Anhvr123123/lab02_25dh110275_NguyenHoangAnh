@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tạo Thanh Navigator</title>
    <style type="text/css">
        a, a:visited {
            display: block;
            position: relative;
            padding: 5px;
            margin: 10px auto;
            border: 2px solid black;
            background-color: lightslategrey;
            border-color: aqua aquamarine antiquewhite;
            text-align: center;
            text-decoration: none;
            width: 100px;
            color: white;
        }

            a:hover {
                color: yellowgreen;
                top: 5px;
                left: 5px;
                background-color: deepskyblue;
            }
    </style>
</head>
<body>
    <div>
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">History</a>
        <a href="#">Offices</a>

    </div>
</body>
</html>