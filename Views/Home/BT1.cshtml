@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
    <style type="text/css">
        * {
            box-sizing: border-box;
        }

        body {
            width: 1000px;
            margin: 20px auto;
            font-family: Arial;
        }

        .main {
            width: 700px;
            margin: auto;
        }

        .menu {
            height: 35px;
            background: #c74762;
            text-align: center;
            color: white;
            padding: 8px;
        }

        .header {
            height: 95px;
            background: #4049a0;
            text-align: center;
            color: white;
            padding: 35px;
            font-size: 20px;
        }

        .content {
            display: flex;
            height: 250px;
        }

        .left {
            width: 70%;
            background: #5fc248;
            padding: 15px;
        }

        .right {
            width: 30%;
            background: #527d43;
            padding: 15px;
        }

        .footer {
            height: 42px;
            background: #b77b1e;
            text-align: center;
            color: white;
            padding: 12px;
        }
    </style>
</head>

<body>

    <div class="main">

        <div class="menu">
            MAIN MENU
        </div>

        <div class="header">
            HEADER
        </div>

        <div class="content">

            <div class="left">
                CONTENT
            </div>

            <div class="right">
                SIDE BAR
            </div>

        </div>

        <div class="footer">
            FOOTER
        </div>

    </div>

</body>
</html>